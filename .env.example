PORT=3000

# Postgres connection
PGHOST=db.xxxxx.supabase.co
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your-password
PGDATABASE=postgres
PGSCHEMA=public
PGSSL=true

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# Firebase Admin (FCM push) — fill from service account JSON
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
